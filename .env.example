# Copy this file to .env and replace placeholders.
# Never commit .env.
orchestrator_base_url=https://<ORCHESTRATOR_FQDN>
orchestrator_api_key=<ORCHESTRATOR_API_KEY>

# Optional private CA bundle for HTTPS verification.
# orchestrator_ca_bundle=/absolute/path/to/ca-bundle.pem

# Optional only when a different API-key header is required.
# orchestrator_api_key_header=X-Auth-Token

# Optional: pin a self-signed certificate by its SHA-256 fingerprint (colons allowed).
# orchestrator_tls_sha256=<SHA-256 fingerprint>

# Several Orchestrators: list nicknames. If orchestrator_base_url and
# orchestrator_api_key are also set, they become one more choice with the nickname "orchestrator". The nickname is what you type on the command line:
#   edgeconnect-auto --orchestrator test discovery
# orch_1=prod
# orch_2=test
# prod_base_url=https://<PROD_ORCHESTRATOR_FQDN>
# prod_api_key=<PROD_API_KEY>
# test_base_url=https://<TEST_ORCHESTRATOR_FQDN>
# test_api_key=<TEST_API_KEY>
# Optional per nickname: <nickname>_ca_bundle, <nickname>_api_key_header,
#   <nickname>_tls_sha256 (pin a self-signed certificate by its SHA-256 fingerprint).
# orchestrator_ca_bundle and orchestrator_api_key_header also apply to a nickname
#   without its own. orchestrator_tls_sha256 does not, and is not used once orch_<N>
#   lines exist, so pin each nickname with <nickname>_tls_sha256.
#
# Used when --orchestrator is not given (a nickname or a slot such as orch_1).
# Without it, the tool shows a menu in a terminal and stops in a script.
# orch_default=prod

# One .env can be shared with edgeconnect-preconfig and the edgeconnect-mcp server
# (setup.sh writes it that way). This CLI ignores their keys, such as EC_VALIDATORS
# and <nickname>_mcp_get_only.
