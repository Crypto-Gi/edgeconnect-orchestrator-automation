# Copy this file to .env and replace placeholders.
# Never commit .env.
orchestrator_base_url=https://<ORCHESTRATOR_FQDN>
orchestrator_api_key=<ORCHESTRATOR_API_KEY>

# Optional private CA bundle for HTTPS verification.
# orchestrator_ca_bundle=/absolute/path/to/ca-bundle.pem

# Optional only when a different API-key header is required.
# orchestrator_api_key_header=X-Auth-Token

# Several Orchestrators: list nicknames. If the two lines above are also set,
# they become one more choice with the nickname "orchestrator". The nickname is what you type on the command line:
#   edgeconnect-auto --orchestrator test discovery
# orch_1=prod
# orch_2=test
# prod_base_url=https://<PROD_ORCHESTRATOR_FQDN>
# prod_api_key=<PROD_API_KEY>
# test_base_url=https://<TEST_ORCHESTRATOR_FQDN>
# test_api_key=<TEST_API_KEY>
# Optional per nickname: <nickname>_ca_bundle, <nickname>_api_key_header
#
# Used when --orchestrator is not given (a nickname or a slot such as orch_1).
# Without it, the tool asks which Orchestrator to use.
# orch_default=prod
